<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembler">
      <HintPath>.\references\Assembler.dll</HintPath>
    </Reference>
    <Reference Include="LibCPU">
      <HintPath>.\references\LibCPU.dll</HintPath>
    </Reference>
    <Reference Include="LibUtils">
      <HintPath>.\references\LibUtils.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>